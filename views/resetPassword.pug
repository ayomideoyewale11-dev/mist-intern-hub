extends layout

//- Uses the same styles as the login page (public/css/login.css).
block head
  link(rel='stylesheet', href='/css/login.css')

block content
  .login
    a.lg-back(href='/login')
      svg(width='24', height='24', viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='1.8', stroke-linecap='round', stroke-linejoin='round', aria-hidden='true')
        path(d='M19 12H5M11 6l-6 6 6 6')
      span Back to log in

    main.lg-main
      .lg-card
        .lg-head
          h1 Choose a new password
          p Enter a new password for your account. Use at least 8 characters.

        form#reset-form(data-token=token)
          .lg-field
            label(for='password') New password
            .lg-pw
              input#password(type='password', minlength='8', required, autocomplete='new-password')
              button.lg-eye(type='button', aria-label='Show password', aria-pressed='false')
                svg(width='20', height='20', viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='1.8', stroke-linecap='round', stroke-linejoin='round', aria-hidden='true')
                  path(d='M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z')
                  circle(cx='12', cy='12', r='3')

          button.lg-submit(type='submit') Save new password
          p.form-status#form-status(role='status', aria-live='polite')

block scripts
  script(src='/js/authClient.js')
  script(src='/js/pwToggle.js')
