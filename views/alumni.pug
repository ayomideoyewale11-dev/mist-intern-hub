extends layout

block head
  link(rel='stylesheet', href='/css/hub.css')
  link(rel='stylesheet', href='/css/tables.css')

block content
  include partials/listTools
  .hub
    include partials/hubHeader

    main.hub-main
      .hub-title
        h1 Alumni
        p Interns whose internship has ended. Their accounts and task history are kept exactly as they were.

      form.arch-tools.alumni-tools(method='get', action='/alumni')
        .arch-find
          .arch-search
            svg(width='18', height='18', viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='2', stroke-linecap='round', aria-hidden='true')
              circle(cx='11', cy='11', r='7')
              path(d='M20 20l-4-4')
            input(type='search', name='q', value=q, placeholder='Search name or email…', aria-label='Search name or email', maxlength='100', data-suggest='alumni')
          button.list-go(type='submit') Search
        .alumni-filter-row
          label.audit-filter
            span Left in
            span.month-picker
              span.month-picker-value= leftIn ? `${leftIn.slice(5, 7)}/${leftIn.slice(0, 4)}` : 'mm/yyyy'
              svg(width='20', height='20', viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='1.8', stroke-linecap='round', stroke-linejoin='round', aria-hidden='true')
                rect(x='3', y='5', width='18', height='16', rx='2')
                path(d='M16 3v4M8 3v4M3 10h18')
              input#alumni-left-in(type='month', name='leftIn', value=leftIn, aria-label='Left in month and year')
          if q || leftIn
            a.hub-outline-link(href='/alumni') Clear

      if alumni.length === 0
        p.tb-empty= (q || leftIn) ? 'No alumni match your filters.' : 'No one has finished their internship yet.'
      else
        p.tb-count= `${total} ${total === 1 ? 'alumnus' : 'alumni'}${(q || leftIn) ? ' found' : ''}`

        //- Wide table: tablet and up
        .tb-card.tb-wide
          table.tb
            thead
              tr
                th(scope='col') Name
                th(scope='col') Email
                th(scope='col') Start date
                th(scope='col') End date
                th(scope='col')
                  span.tb-sr Actions
            tbody
              each a in alumni
                tr
                  td.tb-strong
                    = a.name
                    if a.terminated
                      |  
                      span.tb-pill.is-bad Terminated
                  td.tb-break= a.email
                  td= a.startFormatted
                  td= a.endFormatted
                  td.tb-act
                    a.tb-link(href=`/interns/${a._id}?back=${encodeURIComponent(here)}`)
                      | View
                      span.tb-sr= ` ${a.name}`
                    span.tb-sep  · 
                    a.tb-link(href=`/interns/${a._id}/edit?back=${encodeURIComponent(here)}`)
                      | Edit
                      span.tb-sr= ` ${a.name}`

        //- Narrow table: phones
        .tb-card.tb-narrow
          table.tb
            thead
              tr
                th(scope='col') Intern
                th(scope='col') Internship
                th(scope='col')
                  span.tb-sr View
            tbody
              each a in alumni
                tr
                  td
                    a.tb-rowlink.tb-strong(href=`/interns/${a._id}?back=${encodeURIComponent(here)}`)= a.name
                    if a.terminated
                      span.tb-pill.is-bad Terminated
                    span.tb-sub.tb-break= a.email
                  td
                    span= a.startFormatted
                    span.tb-sub= `to ${a.endFormatted}`
                    a.tb-link(href=`/interns/${a._id}/edit?back=${encodeURIComponent(here)}`) Edit
                  td.tb-chev(aria-hidden='true') ›

      +pager(pg)

block scripts
  script(src='/js/ui.js')
  script(src='/js/authClient.js')
  script(src='/js/hubMenu.js')
  script(src='/js/listTools.js')
  script(src='/js/alumniFilters.js')
