extends layout

block head
  link(rel='stylesheet', href='/css/hub.css')

block content
  include partials/statusIcon
  include partials/listTools
  include partials/progressRing
  .hub
    include partials/hubHeader

    main.hub-main
      .hub-title
        h1 Dashboard
        p Assign tasks to your interns.

      //- summary counts; each box opens the matching list
      .hub-stats
        a.hub-stat(href='/archive?status=open')
          strong= stats.open
          +statusIcon('open', 'Open')
        a.hub-stat(href='/archive?status=overdue', class=(stats.overdue ? 'is-alert' : false))
          strong= stats.overdue
          +statusIcon('overdue', 'Overdue')
        a.hub-stat(href='/archive?status=submitted')
          strong= stats.submitted
          +statusIcon('submitted', 'Submitted')
        a.hub-stat(href='/interns')
          strong= stats.interns
          span Active interns

      if waiting.total
        section#waiting.hub-card.hub-wait-card
          h2= waiting.total === 1 ? '1 submission is waiting for your feedback' : `${waiting.total} submissions are waiting for your feedback`
          ul.hub-wait
            each w in waiting.items
              li
                a(href=`/tasks/${String(w._id)}?back=${encodeURIComponent('/admin')}`)= w.title
                span.hub-wait-meta= `${w.internName} · submitted ${w.submittedFormatted}`
          if waiting.total > waiting.items.length
            p.hub-wait-more= `${waiting.total - waiting.items.length} more. Find them in the Archive, marked “Needs feedback”.`

      if progress.length
        section#progress.hub-card.hub-progress-card
          h2 Intern progress
          ul.hub-progress
            each p in progress
              li
                +progressRing(p, p.name)
                .hub-prog-info
                  a(href=`/interns/${String(p._id)}?back=${encodeURIComponent(here.split('#')[0] + '#progress')}`)= p.name
                  span.hub-prog-count= p.total === 1 ? '1 task' : `${p.total} tasks`
          +pager(progressPager, 'interns')

      section.hub-card
        h2 Assign a task
        form#new-task-form
          .hub-grid
            .hub-field
              label(for='title') Title
              input#title(type='text', maxlength='200', required, placeholder='e.g. Build a login page')
            .hub-field.pick
              label#pick-label(for='pick-btn') Assign to
              button#pick-btn.pick-btn(type='button', aria-haspopup='true', aria-expanded='false', aria-controls='pick-panel')
                span#pick-summary Choose interns…
                svg(width='18', height='18', viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='2', stroke-linecap='round', aria-hidden='true')
                  path(d='M6 9l6 6 6-6')
              #pick-panel.pick-panel(hidden)
                if interns.length === 0
                  p.pick-empty You have no interns yet.
                else
                  input#pick-search(type='search', placeholder='Search interns…', aria-label='Search interns', autocomplete='off')
                  .pick-tools
                    button#pick-all.pick-link(type='button') Select all shown
                    button#pick-clear.pick-link(type='button') Clear
                    span#pick-count.pick-count 0 selected
                  .pick-list(role='group', aria-labelledby='pick-label')
                    each i in interns
                      label.pick-row(data-name=i.name, data-search=(i.name + ' ' + i.email).toLowerCase())
                        input(type='checkbox', name='intern', value=i._id)
                        span.pick-name
                          = i.name
                          span.pick-email= i.email
                  p#pick-none.pick-none(hidden) No interns match your search.
                  button#pick-done.pick-done(type='button') Done
            .hub-field
              label(for='dueDate') Due Date
              input#dueDate(type='date', required)
            .hub-field.hub-full
              label(for='description') Description
              textarea#description(maxlength='5000', required, placeholder='Explain what the intern should do and what to hand in')
          button.hub-submit(type='submit') Assign Task
          p.form-status#form-status(role='status', aria-live='polite')

block scripts
  script(src='/js/common.js')
  script(src='/js/ui.js')
  script(src='/js/authClient.js')
  script(src='/js/hubMenu.js')
  script(src='/js/admin.js')
